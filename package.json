{
  "name": "taskflow",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run db:generate && npm run build -w client && npm run build -w server",
    "start": "npm run start -w server",
    "start:render": "npm run db:deploy && npm start",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run db:generate && npm run build -w client && npm run test --workspaces",
    "test:e2e": "playwright test",
    "db:generate": "npm run db:generate -w server",
    "db:deploy": "npm run db:deploy -w server",
    "db:seed": "npm run db:seed -w server",
    "db:dev": "npm run db:dev -w server",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "node scripts/verify.mjs",
    "test:production": "node scripts/smoke-production.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "typescript-eslint": "8.73.0",
    "globals": "^16.5.0",
    "concurrently": "^9.2.1",
    "@playwright/test": "^1.56.1",
    "prettier": "3.10.1",
    "@axe-core/playwright": "4.14.0"
  }
}
