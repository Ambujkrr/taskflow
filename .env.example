NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://taskflow:taskflow_local_only@localhost:5434/taskflow
# Generate using: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-at-least-48-characters-long
# Separate disposable database, REQUIRED for integration tests. Never use real user data.
TEST_DATABASE_URL=postgresql://taskflow:taskflow_local_only@localhost:5434/taskflow_test
# Optional private seed configuration. Public demo accounts are deliberately avoided.
# SEED_EMAIL=you@example.com
# SEED_PASSWORD=a-unique-strong-password
# SEED_NAME=Ambuj
